# EditorConfig is awesome: https://EditorConfig.org

# 所有文件的默认配置
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java文件
[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# XML文件（pom.xml等）
[*.xml]
indent_style = space
indent_size = 2

# YAML文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Vue、TypeScript、JavaScript文件
[*.{vue,ts,js,tsx,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# Dart文件（Flutter）
[*.dart]
indent_style = space
indent_size = 2
max_line_length = 80

# CSS、SCSS文件
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# JSON文件
[*.json]
indent_style = space
indent_size = 2

# Markdown文件
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# SQL文件
[*.sql]
indent_style = space
indent_size = 2

# Shell脚本
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Windows批处理文件
[*.bat]
end_of_line = crlf
